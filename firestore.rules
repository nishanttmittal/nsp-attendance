rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real (non-anonymous) Google login. Used to gate reads that must NOT leak to
    // anonymous strangers (access-email lists, worker names, attendance problem logs).
    // HARDENED 2026-10-04 (owner approved 19:51 "keep all the rules tight" — do NOT remove; see memory welder-cant-reach-cloud-signup-disabled-2026-10-04).
    // An identity counts only when it is a GOOGLE login with a verified email. A password
    // account anyone could self-register (Email/Password is ON for the WhatsApp sender) or a custom token is NOT a person.
    function gVerified() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.get('email_verified', false) == true; }
    function nonAnon() { return gVerified(); }

    // ===== Self-punch (login-free link for app-only staff e.g. Radhey/Dinesh) =====
    // att_punch: name + in/out times only (NO salary). Written only by the back-office worker job (Admin SDK).
    match /att_punch/{code} {
      // Owner 07-10-2026: "no one would be able to see punch details except me and anshul" → office staff only
      // (owner + active att_users). The login-free punch page can still RECORD a tap (att_self_punch below);
      // it no longer shows the worker his name / today's times, only the "recorded at HH:MM" confirmation.
      allow read: if attStaff();
      allow write: if false;
    }
    // att_self_punch: anyone with the link may CREATE a tap; the worker validates the token
    // server-side before recording it. No client read/update/delete.
    match /att_self_punch/{id} {
      allow create: if request.resource.data.keys().hasOnly(['code','token','dir','date','localTime','ts'])
                    && request.resource.data.keys().hasAll(['code','token','dir','date','localTime'])
                    && request.resource.data.dir in ['in','out']
                    && request.resource.data.code is string && request.resource.data.code.size() < 40
                    && request.resource.data.token is string && request.resource.data.token.size() < 200
                    && request.resource.data.date is string && request.resource.data.date.size() <= 10
                    && request.resource.data.localTime is string && request.resource.data.localTime.size() <= 8;
      allow read, update, delete: if false;
    }

    // ===== NSP Attendance (att_*) =====
    function isAttAdmin() { return gVerified() && request.auth.token.email == 'nspenterprises24@gmail.com'; }
    // attStaff = bootstrap owner OR an ACTIVE att_users/{email} (manager/owner). Gates
    // staff-only reads + who may queue a privileged job (the worker re-checks role too).
    function attStaff() { return isAttAdmin() || (nonAnon()
                          && exists(/databases/$(database)/documents/att_users/$(request.auth.token.email))
                          && get(/databases/$(database)/documents/att_users/$(request.auth.token.email)).data.active != false); }
        match /att_meta/{d} { allow read: if attStaff(); allow write: if false; }
match /att_daily_stats/{d} { allow read: if attStaff(); allow write: if false; }
    // job requests: only staff may create, only for THEMSELVES, only 'pending', only known shape
    // (defence in depth — the worker also authorizes by role before executing). No spoofing requestedBy.
    match /att_job_requests/{d} {
      allow create: if attStaff()
                    && request.resource.data.requestedBy == request.auth.token.email
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['type','payload','requestedBy','status','createdAt']);
      allow read, update: if isAttAdmin();
    }
    // a user may read only their OWN user doc (login role resolution); staff read all; owner writes.
    match /att_users/{u} { allow read: if attStaff() || (nonAnon() && u == request.auth.token.email); allow write: if isAttAdmin(); }
    match /att_attendance/{d} { allow read: if isAttAdmin(); allow write: if false; }
    match /att_punches/{d} { allow read: if isAttAdmin(); allow write: if false; }
    match /att_salary/{d} { allow read, write: if isAttAdmin(); }
    match /att_archive/{d} { allow read: if isAttAdmin(); allow write: if false; }
    match /att_advances/{d} { allow read, write: if isAttAdmin(); }
    match /att_increments/{d} { allow read, write: if isAttAdmin(); }
    match /att_loans/{d} { allow read, write: if isAttAdmin(); }
    match /att_fines/{d} { allow read, write: if isAttAdmin(); }
    match /att_month_locks/{d} { allow read, write: if isAttAdmin(); }
    // scan outputs (names/dates only, no salary) — STAFF read so owner + manager see the Problems tab; jobs write via Admin SDK
    match /att_missed_punch/{d} { allow read: if attStaff(); allow write: if false; }
    match /att_late_log/{d} { allow read: if attStaff(); allow write: if false; }


    // ---- shared helpers ----
    function signedIn() { return request.auth != null; }
    function tEmail() { return gVerified() ? request.auth.token.get('email', '') : ''; }
    function bootstrapOwner() { return tEmail() in ['nspenterprises24@gmail.com']; }

    // ---- welder role helpers ----
    function wPath() { return /databases/$(database)/documents/apps/welder/users/$(tEmail()); }
    function wExists() { return tEmail() != '' && exists(wPath()); }
    function wData() { return get(wPath()).data; }
    function wOwner() { return signedIn() && (bootstrapOwner() || (wExists() && wData().role == 'owner' && wData().active == true)); }
    function wManager() { return signedIn() && (wOwner() || (wExists() && wData().role == 'manager' && wData().active == true)); }

    // ---- plating admin helper ----
    function pPath() { return /databases/$(database)/documents/apps/platingjobwork/users/$(tEmail()); }
    function pExists() { return tEmail() != '' && exists(pPath()); }
    function pOwner() { return signedIn() && (bootstrapOwner() || (pExists() && get(pPath()).data.role == 'owner' && get(pPath()).data.active == true)); }
    function pUser() { return signedIn() && (bootstrapOwner() || (pExists() && get(pPath()).data.active == true)); }

    // ---- Plating Job Work (allowlist-locked: only active users-doc emails + bootstrap owner) ----
    match /apps/platingjobwork/challans/{id} { allow read, write: if pUser(); }
    match /apps/platingjobwork/logs/{id}     { allow read, write: if pUser(); }
    match /apps/platingjobwork/meta/{id}     { allow read, write: if pUser(); }
    match /apps/platingjobwork/incoming/{id} { allow read, write: if pUser(); }
    match /apps/platingjobwork/users/{id}    { allow read: if pUser(); allow write: if pOwner(); }

    // ---- fitting role helpers ----
    function fPath() { return /databases/$(database)/documents/apps/fitting/users/$(tEmail()); }
    function fExists() { return tEmail() != '' && exists(fPath()); }
    function fOwner() { return signedIn() && (bootstrapOwner() || (fExists() && get(fPath()).data.role == 'owner' && get(fPath()).data.active == true)); }
    function fUser() { return signedIn() && (bootstrapOwner() || (fExists() && get(fPath()).data.active == true)); }

    // ---- Fitting (allowlist-locked: only active users-doc emails + bootstrap owner) ----
    // own doc, or the whole list for a Fitting owner (owner 08-10-2026: close the readable users lists)
    match /apps/fitting/users/{id} { allow read: if nonAnon() && (id == tEmail() || fOwner()); allow write: if fOwner(); }
    match /apps/fitting/{collection}/{docId} { allow read, write: if fUser() && collection != 'users'; }
    match /apps/fitting { allow read, write: if fUser(); }

    // ---- Orders (allowlist-locked: only Google users added in Admin → Users) ----
    // TIGHTENED 2026-10-08 (owner: "anshul ji cannot delete anything only modify it and that modification will be
    // available for me to check"; Day Report / Logs / Money are owner-only). What the rules now guarantee, whatever
    // the app or anyone with a staff login tries:
    //   • only the OWNER can delete anything, cancel an order, or change price / advance
    //   • a manager can create orders (as himself, without money), correct them and mark dispatch, but can never
    //     remove a line, change the order number or whose order it is
    //   • customer / item names: staff may ADD, only the owner may change or delete
    //   • the change log is write-once, stamped with the signer's own email, and readable by the owner only
    //   • the order-number counter can only go up
    // The laptop jobs use the Admin SDK and are not affected by these rules.
    function oPath()  { return /databases/$(database)/documents/apps/orders/users/$(tEmail()); }
    function oUser()  { return signedIn() && (bootstrapOwner() || (tEmail() != '' && exists(oPath()) && get(oPath()).data.active == true)); }
    function oOwner() { return signedIn() && (bootstrapOwner() || (tEmail() != '' && exists(oPath()) && get(oPath()).data.active == true && get(oPath()).data.role == 'owner')); }
    // manager or owner (the people who may post to the staff group and correct orders)
    function oManager() { return signedIn() && (bootstrapOwner() || (tEmail() != '' && exists(oPath()) && get(oPath()).data.active == true && get(oPath()).data.role in ['owner', 'manager'])); }
    function oUnchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // users allowlist: only people ON the list (and the owner) may read it — a stranger with a Google account gets
    // nothing, and the app shows him "No access"; only the owner writes
    match /apps/orders/users/{id} { allow read: if oUser(); allow write: if oOwner(); }

    // the staff-group line of an order ("mirror"): staff may only ask for a FAILED line to be sent again — never mark
    // one as sent, never touch what the laptop job recorded
    function oResendOk(n, o) {
      return o.get('mirror', {}).get('status', 'none') in ['held', 'failed', 'uncertain']
             && n.mirror.status == 'pending'
             && n.mirror.diff(o.get('mirror', {})).affectedKeys().hasOnly(['status', 'retry', 'why']);
    }
    // correction / added-line notes for the staff group: ONE new note at the end, signed by the person, waiting to go;
    // notes already there (sent or not) cannot be touched, so a sent note can never be made to go again
    function oNoteOk(n, o) {
      let was = o.get('groupNotes', []);
      let last = n.groupNotes[n.groupNotes.size() - 1];
      return n.groupNotes.size() == was.size() + 1
             && (was.size() == 0 || n.groupNotes[0:was.size()] == was)
             && last.keys().hasOnly(['id', 'kind', 'lines', 'status', 'at', 'by'])
             && last.by == tEmail() && last.status == 'pending' && last.kind in ['ADD', 'EDIT']
             && last.lines is list && last.lines.size() >= 1 && last.lines.size() <= 40;
    }
    function oNewOrderOk(d) {
      let m = d.get('mirror', {});
      let ms = m.get('status', 'none');
      return d.createdByEmail == tEmail()
             && d.get('price', 0) == 0 && d.get('advance', 0) == 0
             && d.status == 'pending' && d.get('source', 'app') == 'app'
             && d.orderNo is string && d.orderNo.matches('^UO-[0-9]{4,6}$')
             && int(d.orderNo.split('-')[1]) < get(/databases/$(database)/documents/apps/orders/meta/counter).data.next
             && d.clientName is string && d.clientName.size() <= 80
             && d.items is list && d.items.size() >= 1 && d.items.size() <= 40
             && !d.keys().hasAny(['groupNotes', 'notePending', 'cancelledAt', 'cancelledBy', 'cancelReason', 'test', 'scanKey', 'scanRef'])
             && m.keys().hasOnly(['status'])
             && (ms == 'none' ? oUser() : (ms == 'pending' && oManager()));
    }
    function oOrderEditOk(n, o, ch) {
      return ch.hasOnly(['clientName', 'items', 'status', 'groupNotes', 'notePending', 'editedAt', 'editedBy', 'lastDispatchAt', 'mirror'])
             && o.get('status', 'pending') != 'cancelled'
             && n.get('status', 'pending') in ['pending', 'production', 'ready', 'dispatched']
             && n.items is list && n.items.size() >= o.get('items', []).size() && n.items.size() <= 40
             && n.clientName is string && n.clientName.size() <= 80
             && (!ch.hasAny(['mirror']) || oResendOk(n, o))
             && (!ch.hasAny(['groupNotes']) || oNoteOk(n, o))
             && (!ch.hasAny(['notePending']) || n.notePending == true)
             && oManager();
    }

    match /apps/orders/orders/{id} {
      allow read: if oUser();
      // a new order is always stamped with the signer's own email; only the owner may enter money; only a manager /
      // owner may ask for a line in the staff group; the number must be one the shared counter has already given out
      allow create: if oOwner() || oNewOrderOk(request.resource.data);
      // manager: may correct an order and enter dispatch — only the listed fields, never the number, whose order it
      // is, money, dates or remarks; never cancel; never end up with fewer lines than before.
      // LIMIT (rules cannot loop over a list): the rule checks the NUMBER of lines, not what is in each line. A manager
      // may rewrite a line's item or quantity — that is the "modify" the owner allows. What makes every such change
      // visible is not this rule but the twice-daily audit snapshot taken by the laptop job (Admin SDK), which compares
      // every order with the copy before and writes its own log entries that no app login can write or alter.
      allow update: if oOwner() || oOrderEditOk(request.resource.data, resource.data, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if oOwner();
    }

    // customer and item names: staff add, only the owner changes or deletes
    match /apps/orders/clients/{id}  { allow read: if oUser(); allow create: if oManager() && request.resource.data.name is string && request.resource.data.name.size() <= 80; allow update, delete: if oOwner(); }
    match /apps/orders/products/{id} { allow read: if oUser(); allow create: if oManager() && request.resource.data.name is string && request.resource.data.name.size() <= 120; allow update, delete: if oOwner(); }

    // change log: write-once, stamped with the signer's own email; only the owner reads it
    match /apps/orders/logs/{id} {
      allow read: if oOwner();
      // `at` must be the SERVER's clock (so an entry cannot be back-dated), and only the known fields are accepted
      allow create: if oUser() && request.resource.data.get('byEmail', '') == tEmail()
                    && request.resource.data.get('at', null) == request.time
                    && request.resource.data.keys().hasOnly(['id', 'ts', 'at', 'action', 'detail', 'by', 'ref', 'byEmail'])
                    && request.resource.data.get('action', '') is string && request.resource.data.get('action', '').size() <= 40
                    && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 2000
                    && (oOwner() || request.resource.data.get('by', '') != 'owner')
                    // these two kinds are written only by the laptop jobs (Admin SDK): no phone login may write one
                    && !(request.resource.data.get('action', '') in ['AUDIT', 'PAD_CORRECTION']);
      allow update, delete: if false;
    }

    // doubts: written by the laptop job (Admin SDK); manager / owner settle them, nobody deletes
    match /apps/orders/doubts/{id} {
      allow read: if oManager();
      allow create: if oOwner();
      allow update: if oOwner() || (oManager() && oUnchanged(['customer', 'question', 'source', 'orderId', 'orderNo', 'createdAt', 'lines']));
      allow delete: if oOwner();
    }

    // order-number counter: the number can only go up
    match /apps/orders/meta/{id} {
      allow read: if oUser();
      // the number moves forward a little at a time: it can never go back, and never be thrown far ahead
      allow create: if oUser() && id == 'counter' && request.resource.data.next is int && request.resource.data.next >= 2 && request.resource.data.next <= 50;
      allow update: if oUser() && id == 'counter' && request.resource.data.next is int && request.resource.data.next > resource.data.next && request.resource.data.next <= resource.data.next + 20;
      allow delete: if false;
    }

    // anything else under apps/orders (old WhatsApp inbox, future collections): owner only
    match /apps/orders/{collection}/{docId} {
      allow read, write: if oOwner() && !(collection in ['users', 'orders', 'clients', 'products', 'logs', 'doubts', 'meta']);
    }
    match /apps/orders { allow read: if oUser(); allow write: if oOwner(); }

    // ---- Welder Contractor (allowlist-locked; staff = entry only, NO pay data) ----
    // wUser = any active allowlisted user (staff/manager/owner) or bootstrap owner.
    function wUser() { return signedIn() && (bootstrapOwner() || (wExists() && wData().active == true)); }
    // entry + stock (staff allowed to read; write where the entry/floor flow needs it)
    // >>> POWDER WELDER GRANT (managed by powder-coating/rules/compose.mjs)
    // powder app (read only): LIST only powder-finish lines dated from its go-live; GET a physical powder line
    // or any line it has already accepted (so a changed/voided line can still be watched). Pay data lives in
    // rates/ledger/settlements/payments, which powder never reads.
    match /apps/welder/dispatches/{id} {
      allow write: if wUser();
      allow get: if wUser() || (pwUser() && (pwWdPhysical(resource.data) || exists(/databases/$(database)/documents/apps/powdercoating/acceptance/$(id))));
      allow list: if wUser() || (pwUser() && resource.data.finish == 'powder' && resource.data.date >= pwGoLive());
    }
    match /apps/welder/products/{id}        { allow read: if wUser() || pwUser(); allow write: if wManager(); }
    // <<< POWDER WELDER GRANT
    match /apps/welder/plating_outbox/{id}  { allow read, write: if wUser(); }
    match /apps/welder/logs/{id}            { allow read, write: if wUser(); }
    match /apps/welder/meta/{id}            { allow read, write: if wUser(); }
    match /apps/welder/parties/{id}         { allow read, write: if wUser(); }
    match /apps/welder/welders/{id}         { allow read: if wUser(); allow write: if wManager(); }
    match /apps/welder/components/{id}      { allow read: if wUser(); allow write: if wManager(); }
    match /apps/welder/receipts/{id}        { allow read: if wUser(); allow write: if wManager(); }
    match /apps/welder/adjustments/{id}     { allow read: if wUser(); allow write: if wOwner(); }
    // pay-sensitive: staff BLOCKED — manager/owner only
    match /apps/welder/rates/{id}        { allow read: if wManager(); allow write: if wOwner(); }
    match /apps/welder/ledger/{id}       { allow read: if wManager(); allow write: if wOwner(); }
    match /apps/welder/settlements/{id}  { allow read: if wManager(); allow write: if wOwner(); }
    match /apps/welder/payments/{id} {
      allow read:           if wManager();
      allow create:         if wManager();
      allow update, delete: if wOwner();
    }
    match /apps/welder/users/{id}    { allow read: if nonAnon(); allow write: if wOwner(); }

    // ---- plastic job work role helpers ----
    function plPath()   { return /databases/$(database)/documents/apps/plasticjobwork/users/$(tEmail()); }
    function plExists() { return tEmail() != '' && exists(plPath()); }
    function plOwner()  { return signedIn() && (bootstrapOwner() || (plExists() && get(plPath()).data.role == 'owner' && get(plPath()).data.active == true)); }
    function plUser()   { return signedIn() && (bootstrapOwner() || (plExists() && get(plPath()).data.active == true)); }

    // ---- Plastic Job Work (allowlist-locked; manager = material in/out, payments owner-only) ----
    match /apps/plasticjobwork/production/{id} { allow read, write: if plUser(); }
    match /apps/plasticjobwork/issues/{id}     { allow read, write: if plUser(); }
    match /apps/plasticjobwork/returns/{id}    { allow read, write: if plUser(); }
    match /apps/plasticjobwork/logs/{id}       { allow read, write: if plUser(); }
    // meta = masters/rates/products/moulders/lot-locks: staff READ, OWNER-only WRITE
    // (a manager must not be able to silently change rates, recipes or lock state).
    match /apps/plasticjobwork/meta/{id}       { allow read: if plUser(); allow write: if plOwner(); }
    // EXCEPTION: the entry-number counter is bumped by every production save (a
    // Firestore transaction), so staff MUST keep write here. Overlapping matches
    // OR in Firestore, so this grants counter-write on top of the owner-only meta.
    match /apps/plasticjobwork/meta/counter    { allow read, write: if plUser(); }
    match /apps/plasticjobwork/purchases/{id}  { allow read, write: if plOwner(); }
    match /apps/plasticjobwork/payments/{id}   { allow read, write: if plOwner(); }
    // own doc, or the whole list for a Plastic owner (owner 07-10-2026: close the readable users lists)
    match /apps/plasticjobwork/users/{id}      { allow read: if nonAnon() && (id == tEmail() || plOwner()); allow write: if plOwner(); }

    // ---- UNICO Laser (BOCHU IoT) — read-only analytics; written only by the sync (Admin SDK).
    // LOCKED: requires a NON-anonymous Google login on the allowlist (bootstrap owner + active
    // emails in apps/laser/users). Costing/margins are competitively sensitive — no anon reads.
    function laserPath() { return /databases/$(database)/documents/apps/laser/users/$(tEmail()); }
    function laserUser() { return nonAnon() && (bootstrapOwner() || (tEmail() != '' && exists(laserPath()) && get(laserPath()).data.active == true)); }
    // Owner = bootstrap, or an active allowlisted user whose role is 'owner' (not a 'meter' staff).
    function laserOwner() { return nonAnon() && (bootstrapOwner() || (tEmail() != '' && exists(laserPath()) && get(laserPath()).data.active == true && get(laserPath()).data.role == 'owner')); }
    match /laser_meta/{id}       { allow read: if laserUser(); allow write: if false; }
    match /laser_days/{id}       { allow read: if laserUser(); allow write: if false; }
    match /laser_jobs/{id}       { allow read: if laserUser(); allow write: if false; }
    // Cost rates (₹/min, salaries, rent, electricity…) — owner-editable via the in-app rate editor.
    // READ is owner-only: cost basis / margins are competitively sensitive and meter-staff screens
    // never load laser_config (loadCore runs only after the role==='owner' gate).
    match /laser_config/{id}     { allow read: if laserOwner(); allow write: if laserOwner(); }
    // Audit log of rate edits (who/when/old->new). Owner-written, append-only in practice.
    match /laser_config_log/{id} { allow read: if laserOwner(); allow write: if laserOwner(); }
    // Effective-dated rate snapshots (one per change) so old months keep old rates. Owner-only read.
    match /laser_rate_history/{id} { allow read: if laserOwner(); allow write: if laserOwner(); }
    match /laser_sync_state/{id} { allow read: if laserUser(); allow write: if false; }
    // Owner-editable: maps a machine file name to its real size (Fix-sizes screen).
    match /laser_size_map/{id}   { allow read: if laserUser(); allow write: if laserUser(); }
    // Daily meter readings entered in-app by staff/owner (the only client-writable laser data).
    // These readings drive laser_days.kWh -> cost per minute -> every margin in the app, so a
    // reading is CREATE-ONLY: staff record a missing date and nobody overwrites or deletes one.
    // The owner corrects a reading through an update that must also name who and when; the app
    // pairs that update with an immutable laser_meter_corrections record in the same batch.
    function meterNumbersOk(d) {
      return d.meterA is number && d.meterA >= 0 && d.meterA <= 100000000
          && d.meterB is number && d.meterB >= 0 && d.meterB <= 100000000
          && d.total is number && d.total == d.meterA + d.meterB
          && d.note is string && d.note.size() <= 300;
    }
    match /laser_meter/{id} {
      allow read: if laserUser();
      // Create: exact shape, id bound to card+date, author is the caller, time is the server's.
      allow create: if laserUser()
        && request.resource.data.keys().hasOnly(['cardId','date','meterA','meterB','total','note','enteredBy','createdAt','schemaVersion'])
        && request.resource.data.keys().hasAll(['cardId','date','meterA','meterB','total','enteredBy','createdAt','schemaVersion'])
        && request.resource.data.cardId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{8}')
        && id == request.resource.data.cardId + '_' + request.resource.data.date
        && meterNumbersOk(request.resource.data)
        && request.resource.data.schemaVersion == 2
        && request.resource.data.enteredBy == tEmail()
        && request.resource.data.createdAt == request.time;
      // Correction: owner only. Card and date are immutable; legacy docs (no enteredBy /
      // createdAt, older enteredAt) stay correctable, which is why those keys are permitted.
      allow update: if laserOwner()
        && request.resource.data.keys().hasOnly(['cardId','date','meterA','meterB','total','note','enteredBy','createdAt','enteredAt','schemaVersion','correctedBy','correctedAt','correctionId'])
        && request.resource.data.cardId == resource.data.cardId
        && request.resource.data.date == resource.data.date
        && meterNumbersOk(request.resource.data)
        && request.resource.data.correctedBy == tEmail()
        && request.resource.data.correctedAt == request.time
        && request.resource.data.correctionId is string;
      allow delete: if false;
    }
    // Immutable evidence of every meter correction: what it was, what it became, and why.
    match /laser_meter_corrections/{id} {
      allow read: if laserOwner();
      allow create: if laserOwner()
        && request.resource.data.correctedBy == tEmail()
        && request.resource.data.correctedAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow update, delete: if false;
    }
    // Job catalog (name + photo, optional file link) — staff/owner add for recall.
    match /laser_job_catalog/{id} { allow read: if laserUser(); allow write: if laserUser(); }
    // Allowlist: any signed-in user may READ (to resolve their own access at login); owner writes.
    match /apps/laser/users/{id} { allow read: if nonAnon() && (id == tEmail() || laserOwner()); allow write: if bootstrapOwner(); }
    // Quote workspace (products/customers/quotes) — owner-only: quotes carry cost basis + margins.
    match /apps/laser/products/{id}  { allow read, write: if laserOwner(); }
    match /apps/laser/customers/{id} { allow read, write: if laserOwner(); }
    match /apps/laser/quotes/{id}    { allow read, write: if laserOwner(); }

    // ---- Inbound leads (IndiaMART + WhatsApp) — read-only command-center feed.
    // Written ONLY by the lead pollers (Admin SDK). Buyer phone numbers = PII, so
    // restrict reads to the non-anonymous bootstrap owner (the CEO dashboard login).
    match /indiamart_leads/{id} { allow read: if nonAnon() && bootstrapOwner(); allow write: if false; }
    match /whatsapp_leads/{id}  { allow read: if nonAnon() && bootstrapOwner(); allow write: if false; }
    // Owner-only triage flags (followup / scrap). Kept SEPARATE from the captured
    // lead data above so the dashboard never mutates the source feed.
    match /lead_status/{id}     { allow read, write: if nonAnon() && bootstrapOwner(); }

    // ---- Transport Freight Hisab (role-based: owner / manager / gaadiwala) ----
    // Staff (manager/owner) = full. Gaadiwala = read ONLY his own transporterId,
    // create/edit/withdraw ONLY his own PENDING/NEEDS_CORRECTION trips; never a
    // passed status, another transporter, payments, or settlements.
    function tfPath() { return /databases/$(database)/documents/apps/transportfreight/users/$(tEmail()); }
    function tfExists() { return tEmail() != '' && exists(tfPath()); }
    function tfData() { return get(tfPath()).data; }
    function tfIsOwner() { return signedIn() && (bootstrapOwner() || (tfExists() && tfData().role == 'owner' && tfData().active == true)); }
    function tfIsManager() { return signedIn() && (tfIsOwner() || (tfExists() && tfData().role == 'manager' && tfData().active == true)); }
    function tfIsGaadiwala() { return signedIn() && tfExists() && tfData().role == 'gaadiwala' && tfData().active == true; }
    function tfMyTid() { return tfExists() ? tfData().transporterId : ''; }
    // Entry charge fields must never be negative (a negative freight would reduce
    // the payable) — the DB backstop for the app-layer dropError() check (P1-2).
    function tfNonNegMoney(d) { return d.get('freight', 0) >= 0 && d.get('lrCharge', 0) >= 0 && d.get('unloading', 0) >= 0 && d.get('misc', 0) >= 0 && d.get('extraPoint', 0) >= 0 && d.get('bags', 0) >= 0; }

    // Reads require a NON-anonymous (Google) login. Gaadiwala names/phones and
    // destination masters are restricted to app MEMBERS (manager/gaadiwala) — a
    // random signed-in Google account that isn't in the app can't read them
    // (P1-1). users: each account reads only its OWN doc (role resolution) unless
    // it's a manager/owner (Admin/login management). The app resolves role from
    // the own users/{email} doc; the bootstrap owner is covered by tfIsManager().
    // Entry charge fields must be non-negative (tfNonNegMoney) so no write can
    // slip a negative freight past the app-layer block (P1-2).
    match /apps/transportfreight/users/{id}        { allow read: if tEmail() == id || tfIsManager(); allow write: if tfIsOwner(); }
    match /apps/transportfreight/transporters/{id} { allow read: if tfIsManager() || (tfIsGaadiwala() && id == tfMyTid()); allow write: if tfIsManager(); }
    match /apps/transportfreight/destinations/{id} { allow read: if tfIsManager() || tfIsGaadiwala(); allow create: if tfIsManager() || tfIsGaadiwala(); allow update, delete: if tfIsManager(); }
    match /apps/transportfreight/meta/{id}         { allow read, write: if tfIsManager(); }
    match /apps/transportfreight/logs/{id}         { allow read: if tfIsManager(); allow create: if nonAnon(); }
    match /apps/transportfreight/entries/{id} {
      // resource == null (fix 2026-07-19): the gaadiwala upload's idempotency guard READS the
      // entry doc BEFORE creating it; on a missing doc `resource.data` dereferences null →
      // permission-denied → his trip sits queued forever ("saved on phone" but never uploads).
      // Reading a nonexistent doc leaks nothing.
      allow read:   if tfIsManager() || (tfIsGaadiwala() && (resource == null || resource.data.transporterId == tfMyTid()));
      // gaadiwala may only submit HIS OWN pending trip, with no challan/approval injected.
      // Every entry write (manager or gaadiwala) must have non-negative charges (P1-2).
      allow create: if (tfIsManager() || (tfIsGaadiwala()
                       && request.resource.data.transporterId == tfMyTid()
                       && request.resource.data.status == 'pending'
                       && request.resource.data.get('challanNo', 0) == 0
                       && request.resource.data.get('approvedBy', '') == ''))
                       && tfNonNegMoney(request.resource.data);
      allow update: if (tfIsManager() || (tfIsGaadiwala()
                       && resource.data.transporterId == tfMyTid()
                       && request.resource.data.transporterId == tfMyTid()
                       && resource.data.status in ['pending','needs_correction']
                       && request.resource.data.status in ['pending','needs_correction']
                       && request.resource.data.get('challanNo', 0) == 0))
                       && tfNonNegMoney(request.resource.data);
      allow delete: if false; // financial record — never hard-deleted (cancel = status; withdraw = deleted flag via update)
    }
    match /apps/transportfreight/advances/{id} {
      allow read:   if tfIsManager() || (tfIsGaadiwala() && resource.data.transporterId == tfMyTid());
      allow create: if tfIsManager();
      allow update: if tfIsManager();
      allow delete: if false; // reversal = a new negative payment, never a delete
    }
    match /apps/transportfreight/settlements/{id} {
      allow read:   if tfIsManager() || (tfIsGaadiwala() && resource.data.transporterId == tfMyTid());
      allow create: if tfIsOwner();
      allow update, delete: if false; // locked, immutable snapshot
    }

    // ---- UNICO Costing (two-vault: owner cost vault + staff price list) ----
    // Cost/margin/breakdown = owner-only. Staff read published prices only.
    function cPath()   { return /databases/$(database)/documents/apps/costing/users/$(tEmail()); }
    function cExists() { return tEmail() != '' && exists(cPath()); }
    function cData()   { return get(cPath()).data; }
    function costStaff(){ return nonAnon() && (bootstrapOwner() || (cExists() && cData().active == true)); }
    function costOwner(){ return nonAnon() && (bootstrapOwner() || (cExists() && cData().active == true && cData().role == 'owner')); }
    match /costing_rates/{id}         { allow read: if costOwner(); allow write: if false; }
    match /costing_recipes/{id}       { allow read: if costOwner(); allow write: if false; }
    match /costing_meta/{id}          { allow read: if costOwner(); allow write: if false; }
    match /costing_prices/{id}        { allow read: if costStaff(); allow write: if costOwner(); }
    match /costing_material_rates/{id} { allow read: if costStaff(); allow write: if costOwner(); }
    match /costing_rate_snapshots/{id} { allow read: if costStaff(); allow write: if false; }
    match /costing_price_history/{id} { allow read: if costOwner(); allow create: if costOwner(); allow update, delete: if false; }
    match /apps/costing/users/{id}    { allow read: if nonAnon() && (id == tEmail() || costOwner()); allow write: if costOwner(); }
    // Quote builder (Phase 1): cut-rates read-only for staff (admin SDK writes them);
    // quotes staff-readable/owner-write; cost snapshot owner-only (two-vault).
    match /costing_cut_rates/{id}     { allow read: if costStaff(); allow write: if false; }
    match /costing_quotes/{id}        { allow read: if costStaff(); allow write: if costOwner(); }
    match /costing_quote_costs/{id}   { allow read, write: if costOwner(); }
    // Table costing app (Phase 1, 2026-07-24): immutable rate sets seeded by admin SDK only;
    // table quotes staff-readable price-only doc + owner-only full cost snapshot (two-vault).
    match /costing_table_ratesets/{id}    { allow read: if costOwner(); allow create: if costOwner(); allow update, delete: if false; }
    match /costing_table_boms/{id}        { allow read: if costOwner(); allow write: if false; }
    match /costing_table_quotes/{id}      { allow read: if costStaff(); allow create: if costOwner(); allow update, delete: if false; }
    match /costing_table_quote_costs/{id} { allow read: if costOwner(); allow create: if costOwner(); allow update, delete: if false; }

    // ---- UNICO Hisab (single-owner money register: daily expenses + supplier payables) ----
    // Financial data (worker advances, supplier balances) — restricted to a NON-anon owner
    // login (bootstrap owner, or an active apps/hisab/users allowlist email). No anon reads.
    function hiPath()  { return /databases/$(database)/documents/apps/hisab/users/$(tEmail()); }
    function hiUser()  { return nonAnon() && (bootstrapOwner() || (tEmail() != '' && exists(hiPath()) && get(hiPath()).data.active == true)); }
    match /apps/hisab/users/{id}           { allow read: if nonAnon() && (id == tEmail() || bootstrapOwner()); allow write: if bootstrapOwner(); }
    match /apps/hisab/{collection}/{docId} { allow read, write: if hiUser() && collection != 'users'; }
    match /apps/hisab                      { allow read, write: if hiUser(); }

    // Hisab pushes a worker advance into this outbox; the owner ACCEPTS it in the
    // destination app (Welder ledger / Salary advances). Owner-only both ways —
    // single owner records in Hisab and accepts in welder/salary.
    match /hisab_advance_outbox/{id}       {
      allow read, write: if nonAnon() && bootstrapOwner();
      // 💸 Self-reported advances from the login-free punch page (2026-08-12): CREATE-only,
      // pending-only, strict shape + ₹50k cap. NOTHING reaches salary until the owner taps
      // Accept in the app's "Hisab advances" screen — a forged entry can only sit in the queue.
      allow create: if request.resource.data.keys().hasOnly(['target','status','code','name','amount','date','note','source','token','ts'])
        && request.resource.data.target == 'salary'
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'punch'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 50000
        && request.resource.data.code is string && request.resource.data.code.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 60
        && request.resource.data.token is string && request.resource.data.token.size() <= 30
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
    }

    // >>> POWDER BLOCK (managed by powder-coating/rules/compose.mjs — do not edit by hand)
    // ---- Powder Coating (apps/powdercoating) — design v4.6, 21-Sep-2026 ----
    // Roles from apps/powdercoating/users/{email}: role 'owner' | 'user1' | 'worker', active == true.
    function pwPath() { return /databases/$(database)/documents/apps/powdercoating/users/$(tEmail()); }
    function pwExists() { return tEmail() != '' && exists(pwPath()); }
    function pwOwner() { return signedIn() && (bootstrapOwner() || (pwExists() && get(pwPath()).data.role == 'owner' && get(pwPath()).data.active == true)); }
    function pwUser() { return signedIn() && (bootstrapOwner() || (pwExists() && get(pwPath()).data.active == true)); }
    function pwRole() { return bootstrapOwner() ? 'owner' : get(pwPath()).data.get('role', 'worker'); }
    // 'YYYY-MM-DD' → the moment that day STARTS in India (00:00 IST = previous day 18:30 UTC).
    function pwDayStartIST(d) { return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) - duration.value(330, 'm'); }
    // A REAL calendar date: shape, month 01-12, day within that month's length, leap years (÷4, not ÷100 unless ÷400).
    function pwLeap(y) { return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0); }
    function pwDaysIn(y, m) { return m == 2 ? (pwLeap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31); }
    function pwIsDate(d) {
      return d is string && d.size() == 10 && d.matches('^20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(d[8:10]) <= pwDaysIn(int(d[0:4]), int(d[5:7]));
    }
    // Edit window: the day has started in India (no tomorrow) and it started at most 3 days ago (today, yesterday, day before).
    function pwRecent(d) { return pwDayStartIST(d) <= request.time && pwDayStartIST(d) >= request.time - duration.value(3, 'd'); }
    function pwPeriodPath(p) { return /databases/$(database)/documents/apps/powdercoating/periods/$(p); }
    function pwPeriodOpen(p) { return !exists(pwPeriodPath(p)) || !(get(pwPeriodPath(p)).data.get('status', 'open') in ['closed', 'closing']); }
    function pwConfigPath() { return /databases/$(database)/documents/apps/powdercoating/meta/config; }
    function pwGoLive() { return get(pwConfigPath()).data.goLiveDate; }
    function pwWdPath(id) { return /databases/$(database)/documents/apps/welder/dispatches/$(id); }
    function pwWd(id) { return get(pwWdPath(id)).data; }
    // a welder line the powder dept physically receives: finish powder, qty > 0, not a pay-only row, dated from go-live
    function pwWdPhysical(d) { return d.finish == 'powder' && d.qty is number && d.qty > 0 && d.get('payBasis', '') != 'final-dispatch'; }
    function pwWdMatchesSnapshot(id, snap) {
      return exists(pwWdPath(id)) && pwWdPhysical(pwWd(id))
        && pwWd(id).qty == snap.qty && pwWd(id).get('date', '') == snap.date && pwWd(id).finish == snap.finish
        && pwWd(id).get('productName', '') == snap.productName && pwWd(id).get('welderChallan', '') == snap.welderChallan
        && pwWd(id).get('welder', '') == snap.welder && snap.date >= pwGoLive();
    }
    function pwMvPath(m) { return /databases/$(database)/documents/apps/powdercoating/movements/$(m); }
    function pwMvBefore(m) { return get(pwMvPath(m)).data; }
    function pwMvAfter(m) { return getAfter(pwMvPath(m)).data; }
    function pwAccPath(id) { return /databases/$(database)/documents/apps/powdercoating/acceptance/$(id); }
    function pwMv() { return request.resource.data; }
    function pwQtyOk() { return pwMv().qty is int && pwMv().qty >= 1 && pwMv().qty <= 100000; }
    function pwBase(id) {
      return pwMv().keys().hasOnly(['id','type','date','period','productId','productName','qty','source','welder','welderDispatchId','welderChallan','qtySent','reason','note','reverses','opId','createdBy','createdByRole','deviceId','createdAt','clientAt','schemaVersion'])
        && pwMv().id == id
        && pwMv().createdBy == tEmail()
        && pwMv().createdAt == request.time
        && pwIsDate(pwMv().date)
        && pwMv().period == pwMv().date[0:7]
        && pwMv().productId is string && pwMv().productId.size() > 0 && pwMv().productId.size() <= 120
        && pwMv().productName is string && pwMv().productName.size() <= 120
        && pwMv().opId is string && pwMv().opId.size() > 0 && pwMv().opId.size() <= 80
        && pwMv().deviceId is string && pwMv().deviceId.size() <= 40
        && pwMv().createdByRole in ['worker','user1','owner'] && pwMv().createdByRole == pwRole()
        && pwMv().clientAt is string && pwMv().clientAt.size() <= 40
        && pwMv().schemaVersion is int && pwMv().schemaVersion >= 1;
    }
    function pwIsWelderReceive() { return pwMv().type == 'receive' && 'welderDispatchId' in pwMv() && pwMv().welderDispatchId is string && pwMv().welderDispatchId != ''; }
    // direct receipt (no welder line): workers may book press / laser / other; 'welder' is NEVER a direct source;
    // pre-go-live material from a welder without an app challan is owner-only (sources naveen / jitender).
    function pwDirectSourceOk() {
      return pwMv().source is string && pwMv().source != 'welder'
        && (pwMv().source in ['press','laser','other'] || (pwOwner() && pwMv().source in ['naveen','jitender']));
    }
    // A welder receipt is only valid together with the acceptance transition written in the SAME operation:
    // the acceptance (after) points at this movement, and the movement's key fields equal the acceptance's stored snapshot.
    function pwWelderReceiveLinked(id) {
      return existsAfter(pwAccPath(pwMv().welderDispatchId))
        && ((id.matches('^rcv_.*') && getAfter(pwAccPath(pwMv().welderDispatchId)).data.lastOp.kind == 'receive' && getAfter(pwAccPath(pwMv().welderDispatchId)).data.lastOp.movementId == id)
            || (id.matches('^fix_.*') && getAfter(pwAccPath(pwMv().welderDispatchId)).data.lastOp.kind == 'fix' && 'fix_' + getAfter(pwAccPath(pwMv().welderDispatchId)).data.lastOp.movementId == id))
        && getAfter(pwAccPath(pwMv().welderDispatchId)).data.lastOp.opId == pwMv().opId
        && pwMv().productId == getAfter(pwAccPath(pwMv().welderDispatchId)).data.productId
        && pwMv().qtySent == getAfter(pwAccPath(pwMv().welderDispatchId)).data.snapshot.qty
        && pwMv().welderChallan == getAfter(pwAccPath(pwMv().welderDispatchId)).data.snapshot.welderChallan
        && pwMv().source == 'welder';
    }
    // Worker/User1 entry types. Owner may backdate; others only within the window. Period must be open for everyone.
    function pwEntry(id) {
      return pwMv().type in ['receive','coat_ok','rework','scrap'] && pwQtyOk()
        && pwPeriodOpen(pwMv().period)
        && (pwOwner() || pwRecent(pwMv().date))
        && (pwMv().type != 'receive' || pwIsWelderReceive() || pwDirectSourceOk())
        && (!pwIsWelderReceive() || (id.matches('^(fix_)*rcv_' + pwMv().welderDispatchId + '_[0-9]+$') && pwWelderReceiveLinked(id)))
        && (pwMv().type != 'scrap' || (pwMv().reason is string && pwMv().reason.size() > 0));
    }
    function pwOpening(id) {
      return pwMv().type == 'opening' && pwOwner() && pwMv().qty is int && pwMv().qty >= 0 && pwMv().qty <= 1000000
        && id == 'opn_' + pwMv().productId
        && pwPeriodOpen(pwMv().period)
        && exists(pwConfigPath()) && pwMv().date == pwGoLive();
    }
    // Adjustment: owner, open period, and the period doc written in the same operation must point at it as the
    // ONE effective adjustment for the product; if a previous pointer existed, that adjustment is reversed in the same write.
    function pwAdjustment(id) {
      return pwMv().type == 'adjustment' && pwOwner() && pwPeriodOpen(pwMv().period)
        && pwMv().qty is int && pwMv().qty != 0 && pwMv().qty >= -100000 && pwMv().qty <= 100000
        && pwMv().reason is string && pwMv().reason.size() > 0
        && id.matches('^adj_' + pwMv().period + '_' + pwMv().productId + '_[0-9]+$')
        && existsAfter(pwPeriodPath(pwMv().period))
        && getAfter(pwPeriodPath(pwMv().period)).data.effAdj[pwMv().productId] == id
        && (!exists(pwPeriodPath(pwMv().period))
            || !('effAdj' in get(pwPeriodPath(pwMv().period)).data)
            || !(pwMv().productId in get(pwPeriodPath(pwMv().period)).data.effAdj)
            || existsAfter(pwMvPath('rev_' + get(pwPeriodPath(pwMv().period)).data.effAdj[pwMv().productId]))
            || exists(pwMvPath('rev_' + get(pwPeriodPath(pwMv().period)).data.effAdj[pwMv().productId])));
    }
    function pwOrigPath() { return pwMvPath(request.resource.data.reverses); }
    function pwOrig() { return get(pwOrigPath()).data; }
    // Reversal: rev_<orig>; orig exists, is not a reversal and not an opening; copies the original's
    // date/period/product/qty; the ORIGINAL's period must be open (owner reopens first, logged);
    // owner any age, else own entry within 2 days of the ORIGINAL's createdAt.
    function pwReversal(id) {
      return pwMv().type == 'reversal' && pwMv().reverses is string && id == 'rev_' + pwMv().reverses
        && exists(pwOrigPath()) && pwOrig().type != 'reversal' && pwOrig().type != 'opening'
        && pwMv().productId == pwOrig().productId && pwMv().qty == pwOrig().qty
        && pwMv().date == pwOrig().date && pwMv().period == pwOrig().period
        && pwPeriodOpen(pwOrig().period)
        && (pwOwner() || (pwOrig().type in ['receive','coat_ok','rework','scrap']
            && pwOrig().createdBy == tEmail()
            && request.time - pwOrig().createdAt <= duration.value(2, 'd')));
    }
    match /apps/powdercoating/movements/{id} {
      allow read: if pwUser();
      allow update, delete: if false;
      allow create: if pwUser() && pwBase(id) && (pwEntry(id) || pwOpening(id) || pwAdjustment(id) || pwReversal(id));
    }

    // acceptance/{welderDispatchId}: only meaningful together with the ledger, so every write must be
    // consistent with movements written in the SAME operation, and those movements must be NEW in this
    // operation (not existing before it) so a transition can never be replayed against old documents.
    //   receive → seq+1, rcv_<id>_<seq> is new, is a welder receive for this dispatch/product/opId/creator,
    //             and receivedTotal grew by exactly its qty
    //   fix     → rev_<orig> and fix_<orig> are new and linked; delta = fix.qty − orig.qty
    //   cancel  → rev_<orig> is new and linked; delta = −orig.qty; status back to open
    //   close   → nothing changes but the status (open → short-closed)
    // The welder snapshot, productId and dispatch id never change after the first write.
    function pwAcc() { return request.resource.data; }
    function pwAccPrev() { return resource.data; }
    function pwNewMv(m) { return !exists(pwMvPath(m)) && existsAfter(pwMvPath(m)); }
    function pwAccShape(id) {
      return pwAcc().welderDispatchId == id && pwAcc().receivedTotal is int && pwAcc().receivedTotal >= 0
        && pwAcc().seq is int && pwAcc().seq >= 0
        && pwAcc().status in ['open','complete','short-closed']
        && pwAcc().lastOp is map && pwAcc().lastOp.kind in ['receive','fix','cancel','close']
        && pwAcc().lastOp.by == tEmail() && pwAcc().lastOp.opId is string && pwAcc().lastOp.opId.size() > 0
        && pwAcc().snapshot is map && pwAcc().snapshot.qty is number
        && pwAcc().productId is string && pwAcc().productId.size() > 0;
    }
    function pwAccStatusOk() {
      return (pwAcc().status == 'short-closed' && pwAcc().lastOp.kind in ['close','fix'])
        || (pwAcc().status == 'complete' && pwAcc().receivedTotal >= pwAcc().snapshot.qty)
        || (pwAcc().status == 'open' && pwAcc().receivedTotal < pwAcc().snapshot.qty);
    }
    // the ORIGINAL movement a fix/cancel refers to must be THIS acceptance's own welder receipt
    function pwAccOrigBelongs(id) {
      return pwMvBefore(pwAcc().lastOp.movementId).type == 'receive' && pwMvBefore(pwAcc().lastOp.movementId).source == 'welder'
        && pwMvBefore(pwAcc().lastOp.movementId).welderDispatchId == id
        && pwMvBefore(pwAcc().lastOp.movementId).productId == pwAcc().productId
        && pwMvBefore(pwAcc().lastOp.movementId).qtySent == pwAcc().snapshot.qty
        && pwMvBefore(pwAcc().lastOp.movementId).welderChallan == pwAcc().snapshot.welderChallan;
    }
    function pwAccMvLinked(m, id) {
      return pwMvAfter(m).type == 'receive' && pwMvAfter(m).welderDispatchId == id
        && pwMvAfter(m).productId == pwAcc().productId && pwMvAfter(m).opId == pwAcc().lastOp.opId
        && pwMvAfter(m).createdBy == tEmail();
    }
    function pwAccReceive(id, prevTotal, prevSeq) {
      return pwAcc().lastOp.kind == 'receive' && pwAcc().seq == prevSeq + 1
        && pwAcc().lastOp.movementId == 'rcv_' + id + '_' + string(pwAcc().seq)
        && pwNewMv(pwAcc().lastOp.movementId) && pwAccMvLinked(pwAcc().lastOp.movementId, id)
        && pwAcc().receivedTotal == prevTotal + pwMvAfter(pwAcc().lastOp.movementId).qty;
    }
    function pwAccFix(id, prevTotal) {
      return pwAcc().lastOp.kind == 'fix' && pwAcc().seq == pwAccPrev().seq
        && exists(pwMvPath(pwAcc().lastOp.movementId)) && pwAccOrigBelongs(id)
        && pwNewMv('rev_' + pwAcc().lastOp.movementId) && pwNewMv('fix_' + pwAcc().lastOp.movementId)
        && pwMvAfter('rev_' + pwAcc().lastOp.movementId).reverses == pwAcc().lastOp.movementId
        && pwMvAfter('rev_' + pwAcc().lastOp.movementId).opId == pwAcc().lastOp.opId
        && pwAccMvLinked('fix_' + pwAcc().lastOp.movementId, id)
        && pwAcc().receivedTotal == prevTotal - pwMvBefore(pwAcc().lastOp.movementId).qty + pwMvAfter('fix_' + pwAcc().lastOp.movementId).qty;
    }
    function pwAccCancel(id, prevTotal) {
      return pwAcc().lastOp.kind == 'cancel' && pwAcc().seq == pwAccPrev().seq && pwAcc().status == 'open'
        && exists(pwMvPath(pwAcc().lastOp.movementId)) && pwAccOrigBelongs(id)
        && pwNewMv('rev_' + pwAcc().lastOp.movementId)
        && pwMvAfter('rev_' + pwAcc().lastOp.movementId).reverses == pwAcc().lastOp.movementId
        && pwMvAfter('rev_' + pwAcc().lastOp.movementId).opId == pwAcc().lastOp.opId
        && pwAcc().receivedTotal == prevTotal - pwMvBefore(pwAcc().lastOp.movementId).qty;
    }
    function pwAccClose() {
      return pwAcc().lastOp.kind == 'close' && pwAcc().seq == pwAccPrev().seq && pwAcc().status == 'short-closed'
        && pwAcc().receivedTotal == pwAccPrev().receivedTotal && pwAccPrev().status == 'open';
    }
    match /apps/powdercoating/acceptance/{id} {
      allow read: if pwUser();
      allow delete: if false;
      // first acceptance: the snapshot must equal the REAL welder dispatch (server-side, not trusted from the client)
      allow create: if pwUser() && pwAccShape(id) && pwAccStatusOk() && pwAccReceive(id, 0, 0)
        && pwWdMatchesSnapshot(id, pwAcc().snapshot);
      // more material on a partial line: the live welder dispatch must still agree with the stored snapshot (the freeze, enforced)
      allow update: if pwUser() && pwAccShape(id) && pwAccStatusOk()
        && pwAcc().snapshot == pwAccPrev().snapshot && pwAcc().productId == pwAccPrev().productId
        && ((pwAccReceive(id, pwAccPrev().receivedTotal, pwAccPrev().seq) && pwAccPrev().status == 'open' && pwWdMatchesSnapshot(id, pwAccPrev().snapshot))
            || pwAccFix(id, pwAccPrev().receivedTotal) || pwAccCancel(id, pwAccPrev().receivedTotal) || pwAccClose());
    }
    // daily/{date}: shape-locked; rev advances by exactly one; attributed to the caller; non-negative numbers.
    function pwDay() { return request.resource.data; }
    function pwDayShape(date) {
      return pwDay().keys().hasOnly(['id','date','period','noProduction','meterReading','meterAt','freshKg','reclaimedKg','notes','rev','updatedBy','updatedAt','updatedAtClient','createdBy','createdAt','history'])
        && pwDay().id == date && pwDay().date == date && pwDay().period == date[0:7]
        && pwDay().noProduction is bool
        && (pwDay().meterReading == null || (pwDay().meterReading is number && pwDay().meterReading >= 0))
        && (pwDay().freshKg == null || (pwDay().freshKg is number && pwDay().freshKg >= 0 && pwDay().freshKg <= 10000))
        && (pwDay().reclaimedKg == null || (pwDay().reclaimedKg is number && pwDay().reclaimedKg >= 0 && pwDay().reclaimedKg <= 10000))
        && pwDay().notes is string && pwDay().notes.size() <= 500
        && pwDay().updatedBy == tEmail() && pwDay().updatedAt == request.time && pwDay().rev is int
        && pwDay().history is list && pwDay().history.size() <= 20;
    }
    // history = previous entries + exactly one new summary (of the doc being replaced), capped at 20 (oldest dropped)
    function pwDayHistoryAppended() {
      return pwDay().history is list && resource.data.history is list
        && ((resource.data.history.size() < 20 && pwDay().history.size() == resource.data.history.size() + 1
             && (resource.data.history.size() == 0 || pwDay().history[0:resource.data.history.size()] == resource.data.history))
            || (resource.data.history.size() == 20 && pwDay().history.size() == 20 && pwDay().history[0:19] == resource.data.history[1:20]))
        && pwDay().history[pwDay().history.size() - 1] is map
        && pwDay().history[pwDay().history.size() - 1].get('by', '') == resource.data.updatedBy;
    }
    match /apps/powdercoating/daily/{date} {
      allow read: if pwUser();
      allow delete: if false;
      allow create: if pwUser() && pwIsDate(date) && pwDayShape(date) && pwDay().rev == 1 && pwDay().createdBy == tEmail() && pwDay().history.size() == 0
        && pwPeriodOpen(date[0:7]) && (pwOwner() || pwRecent(date));
      allow update: if pwUser() && pwIsDate(date) && pwDayShape(date) && pwDay().rev == resource.data.rev + 1
        && pwDay().createdBy == resource.data.createdBy && pwDay().createdAt == resource.data.createdAt
        && pwDayHistoryAppended()
        && pwPeriodOpen(date[0:7]) && (pwOwner() || pwRecent(date));
    }
    // periods/{YYYY-MM}: owner-only, explicit state machine  open → closing → closed → open (reopen with reason).
    //   open/absent → open: count, adjSeq, effAdj may change
    //   open → closing: closingToken set; nothing else changes
    //   closing → closed | open: only by the operation holding closingToken; count unchanged
    //   closed → open: reopenReason required; count unchanged
    function pwPer() { return request.resource.data; }
    function pwPerStatus(d) { return d.get('status', 'open'); }
    function pwPerKeys() { return pwPer().keys().hasOnly(['id','status','countByProduct','countedAt','countedBy','adjSeq','effAdj','closingToken','closeOpToken','closingAt','closingAtTs','closingBy','closedAt','closedBy','bookAtClose','reopenedAt','reopenedBy','reopenReason','recoveredAt','recoveredBy','updatedAt']); }
    match /apps/powdercoating/periods/{id} {
      allow read: if pwUser();
      allow delete: if false;
      allow create: if pwOwner() && pwPerKeys() && pwPer().id == id && pwPerStatus(pwPer()) == 'open';
      allow update: if pwOwner() && pwPerKeys() && pwPer().id == id && (
        (pwPerStatus(resource.data) == 'open' && pwPerStatus(pwPer()) == 'open')
        || (pwPerStatus(resource.data) == 'open' && pwPerStatus(pwPer()) == 'closing'
            && pwPer().closingToken is string && pwPer().closingToken.size() > 0 && pwPer().closingAtTs == request.time
            && pwPer().get('countByProduct', {}) == resource.data.get('countByProduct', {}))
        // the finishing write must PRESENT the token in closeOpToken (a merge would silently inherit closingToken itself)
        || (pwPerStatus(resource.data) == 'closing' && pwPerStatus(pwPer()) in ['closed', 'open']
            && pwPer().get('closeOpToken', '') == resource.data.closingToken
            && pwPer().get('countByProduct', {}) == resource.data.get('countByProduct', {}))
        // stranded closing (connection died mid-handshake): owner may release it back to open after 10 minutes
        || (pwPerStatus(resource.data) == 'closing' && pwPerStatus(pwPer()) == 'open'
            && resource.data.closingAtTs is timestamp && request.time - resource.data.closingAtTs > duration.value(10, 'm')
            && pwPer().get('countByProduct', {}) == resource.data.get('countByProduct', {}))
        || (pwPerStatus(resource.data) == 'closed' && pwPerStatus(pwPer()) == 'open'
            && pwPer().reopenReason is string && pwPer().reopenReason.size() > 0
            && pwPer().get('countByProduct', {}) == resource.data.get('countByProduct', {})));
    }
    // meta/config: the go-live date is written ONCE (create only), never updated or deleted — it anchors the welder
    // queue, the opening date and the rules; changing it later would move three accounting boundaries at once.
    match /apps/powdercoating/meta/config {
      allow read: if pwUser();
      allow update, delete: if false;
      allow create: if pwOwner()
        && request.resource.data.keys().hasOnly(['goLiveDate','setBy','setAt'])
        && pwIsDate(request.resource.data.goLiveDate)
        && request.resource.data.setBy == tEmail() && request.resource.data.setAt == request.time;
    }
    match /apps/powdercoating/meta/{id}    { allow read: if pwUser(); allow write: if pwOwner() && id != 'config'; }
    // logs: OWNER actions only, fixed action set, shape-locked; create-only. Never an audit source of truth
    // (movements / periods / config carry their own createdBy / closedBy / setBy).
    match /apps/powdercoating/logs/{id} {
      allow read: if pwUser();
      allow update, delete: if false;
      allow create: if pwOwner() && request.resource.data.by == tEmail() && request.resource.data.role == 'owner'
        && request.resource.data.keys().hasOnly(['id','ts','createdAt','action','detail','by','role'])
        && request.resource.data.id == id && request.resource.data.ts is string && request.resource.data.detail is map
        && request.resource.data.action in ['MONTH_COUNT','PERIOD_CLOSE_REFUSED','PERIOD_CLOSING_RECOVERED','PERIOD_REOPEN','USER_SET','PRODUCT_ALIAS']
        && request.resource.data.createdAt == request.time;
    }
    // users allowlist: any signed-in device may READ (to resolve role at login); only owner WRITES
    // users: a signed-in Google account may read ITS OWN doc (to resolve its role); only the owner lists/writes
    match /apps/powdercoating/users/{id}   { allow get: if nonAnon() && (id == tEmail() || pwOwner()); allow list: if pwOwner(); allow write: if pwOwner(); }
    // <<< POWDER BLOCK
    // >>> FALCON BLOCK (managed by falcon/rules/compose.mjs — do not edit by hand)
    // ---- FALCON (apps/falcon) — falcon/SPEC.md, 01-Oct-2026; slimmed 04-Oct (one role lookup per write) ----
    // Roles from apps/falcon/users/{email}: role 'owner' | 'incharge' | 'spender', active == true. Google login only.
    // Money integrity: every entry/transfer create or cancel is ONE batch with its balances/{email} write (a transfer with fromBal == true —
    // worker → worker 'hand', or Anshul ji's give / wapas — writes TWO balances: giver and receiver);
    // each side checks the other with getAfter (lastOp = 'e:'|'x:'|'t:'|'y:' + record id). No deletes anywhere.
    // Firestore evaluates at most 1,000 expressions per request, so each rule resolves the caller's role ONCE
    // (`let role = fxRoleOf()`) instead of calling fxActive/fxStaff/fxOwner repeatedly.
    function fxMe() { return tEmail().lower(); }
    function fxG() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.get('email_verified', false) == true; }
    function fxP(c, id) { return /databases/$(database)/documents/apps/falcon/$(c)/$(id); }
    // role stored on a users doc, '' when switched off
    function fxUserRole(p) { let u = get(p).data; return u.active == true ? u.get('role', '') : ''; }
    // caller's role: 'owner' | 'incharge' | 'spender' | '' (no Google login, not added, or switched off)
    function fxRoleOf() {
      return !fxG() || fxMe() == '' ? ''
        : (bootstrapOwner() ? 'owner' : (exists(fxP('users', fxMe())) ? fxUserRole(fxP('users', fxMe())) : ''));
    }
    function fxActive() { return fxRoleOf() != ''; }
    function fxLeap(y) { return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0); }
    function fxDaysIn(y, m) { return m == 2 ? (fxLeap(y) ? 29 : 28) : (m in [4, 6, 9, 11] ? 30 : 31); }
    function fxIsDate(d) {
      return d is string && d.size() == 10 && d.matches('^20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(d[8:10]) <= fxDaysIn(int(d[0:4]), int(d[5:7]));
    }
    // 'YYYY-MM-DD' → the moment that day starts in India. A line may be dated today or up to 7 days back
    // (an offline phone syncs late), never in the future (5-minute grace for a phone clock running fast).
    function fxDayStart(d) { return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10])) - duration.value(330, 'm'); }
    function fxDateOk(d) { return fxIsDate(d) && fxDayStart(d) <= request.time + duration.value(5, 'm') && fxDayStart(d) >= request.time - duration.value(8, 'd'); }
    function fxInt(n, max) { return n is int && n > 0 && n <= max; }
    function fxStr(s, max) { return s is string && s.size() <= max; }
    function fxLastOp(email) { return getAfter(fxP('balances', email)).data.get('lastOp', ''); }
    // active → cancelled, by the caller, now, with a reason; nothing else may change
    function fxCancelOk(me, o, r) {
      return r.diff(o).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledAt'])
        && o.status == 'active' && r.status == 'cancelled'
        && r.cancelledBy == me && r.cancelledAt == request.time
        && r.cancelReason is string && r.cancelReason.size() > 0 && r.cancelReason.size() <= 100;
    }

    function fxUsersRead(id) { let role = fxRoleOf(); return role != '' && (id == fxMe() || role in ['owner', 'incharge']); }
    // the people list (name, Gmail, role): any active member — a worker picks the saathi he hands cash to (owner 08-10-2026)
    function fxUsersList() { return fxRoleOf() != ''; }
    function fxUsersCreate(id) {
      let d = request.resource.data;
      return fxRoleOf() == 'owner' && id == id.lower()
        && d.keys().hasOnly(['email', 'name', 'role', 'active', 'addedBy', 'addedAt'])
        && d.email == id && d.role in ['owner', 'incharge', 'spender']
        && d.active is bool && fxStr(d.name, 40) && d.name.size() > 0;
    }
    match /apps/falcon/users/{id} {
      allow read: if fxUsersList();
      allow create: if fxUsersCreate(id);
      // after creation the app only switches a person on/off — name and role never change from a phone
      allow update: if fxRoleOf() == 'owner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'addedBy', 'addedAt'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // heads a tile may write. 'Suspense' is NOT here on purpose (only a staff correction may park a line there).
    // Contractor / Party payment / Owner personal = Anshul ji's tiles (owner 08-10-2026).
    function fxHead(h) {
      return h in ['Tea', 'Purchase Tax Free', 'Cartage', 'Petrol', 'Food', 'Loading/unloading', 'Maintanance Account', 'Factory Exp',
        'Kaanta', 'Safai saman', 'Die / tool kaam', 'Office saman', 'Pani', 'Medical / pooja', 'Contractor', 'Party payment', 'Owner personal'];
    }
    function fxEntryRead() { let role = fxRoleOf(); return role != '' && (resource.data.by == fxMe() || role in ['owner', 'incharge']); }
    function fxEntryCreate(id) {
      let d = request.resource.data;
      let me = fxMe();
      let role = fxRoleOf();
      return role != ''
        && d.keys().hasOnly(['id', 'by', 'byName', 'kind', 'head', 'amount', 'detail', 'place', 'advFor', 'advStatus',
             'date', 'hasPhoto', 'status', 'createdAt', 'clientAt', 'deviceId', 'schemaVersion', 'approval', 'hisab', 'selfAdv'])
        && d.id == id && d.by == me
        // approval (owner 08-10-2026): a worker's line waits for the owner / Anshul ji; their own lines are OK at once.
        // hisab: null until the line is closed into a 'Hisab final'.
        // (d.get: a phone still on the old build in the cut-over minutes sends neither key — treated as pending / null)
        && d.get('approval', 'pending') == (role == 'spender' ? 'pending' : 'ok') && d.get('hisab', null) == null
        && d.kind in ['chai', 'saman', 'rick', 'petrol', 'khana', 'labour', 'bilty', 'repair', 'other', 'adv']
        // one line: a worker up to ₹50,000; Anshul ji / owner up to ₹2,00,000 (his hisab has ₹1,00,000 lines)
        && fxInt(d.amount, role == 'spender' ? 50000 : 200000) && fxDateOk(d.date)
        && d.status == 'active' && d.createdAt == request.time
        && d.hasPhoto is bool && fxStr(d.detail, 120) && fxStr(d.head, 40) && fxStr(d.byName, 40)
        // head is written by the phone: only the heads the tiles use (fxHead), so a tampered phone cannot invent one
        && (d.head == '' || fxHead(d.head))
        // Anshul ji's heads are not a worker's
        && (role != 'spender' || !(d.head in ['Contractor', 'Party payment', 'Owner personal']))
        && (d.kind != 'adv' || d.advStatus == 'pending')
        // Khud ka advance (owner 09-10-2026 "build b"): a worker's advance to HIMSELF must carry selfAdv == true (so it shows in red to whoever
        // passes it — owner or Anshul ji, owner 09-10 23:24), and only such a line may carry it. "Himself" = the Attendance code on his own users doc (selfCode, never set from a phone).
        && (!('selfAdv' in d) || (d.selfAdv == true && d.kind == 'adv' && role == 'spender'))
        && (role != 'spender' || d.kind != 'adv' || d.get('selfAdv', false) == true || fxNotSelf(me, d.get('advFor', {}).get('code', '')))
        // photo compulsory for a spender: saman + bilty always; petrol / repair / other above ₹200 (same as logic/falcon.js
        // photoRequired). Anshul ji and the owner may save without one (owner 07-10-2026: "anshul need not enter photos").
        && (role != 'spender' || !(d.kind in ['saman', 'bilty'] || (d.kind in ['petrol', 'repair', 'other'] && d.amount > 200)) || d.hasPhoto == true)
        && (d.hasPhoto == false || existsAfter(fxP('photos', id)))
        && fxLastOp(me) == 'e:' + id;
    }
    function fxNotSelf(me, code) { return code == '' || code != get(fxP('users', me)).data.get('selfCode', '~'); }
    // also a Karigar / thekedar line that went to the Welder inbox (any kind): queued or accepted there
    function fxAdvLocked(o) { return (o.kind == 'adv' && o.get('advStatus', '') == 'entered') || o.get('advPush', {}).get('status', '') in ['queued', 'accepted']; }
    function fxEntryUpdate(id) {
      let role = fxRoleOf();
      let me = fxMe();
      let o = resource.data;
      let r = request.resource.data;
      return role != '' && o.get('hisab', null) == null && (
        // a line cancelled by staff goes BACK to the worker (owner 08-10-2026 23:52); he marks it seen — his own line only
        (o.by == me && o.status == 'cancelled' && o.get('cancelledBy', '') != me && o.get('rejectAck', false) == false
          && r.diff(o).affectedKeys().hasOnly(['rejectAck', 'rejectAckAt'])
          && r.rejectAck == true && r.rejectAckAt == request.time)
        // staff OK a worker's line (owner 08-10-2026): nothing else changes, money untouched
        ||
        (role in ['owner', 'incharge'] && o.status == 'active' && o.get('approval', 'pending') == 'pending'
          && r.diff(o).affectedKeys().hasOnly(['approval', 'approvedBy', 'approvedAt'])
          && r.approval == 'ok' && r.approvedBy == me && r.approvedAt == request.time)
        // Hisab final: staff close every line of one worker into hisabs/{hid} (created in the same batch); only OK'd or
        // cancelled lines may close, so nothing pending ever disappears from the worker's screen unreviewed
        || (role in ['owner', 'incharge'] && r.diff(o).affectedKeys().hasOnly(['hisab'])
          && r.hisab is string && fxHisabOf(r.hisab, o.by)
          // a line staff sent back must have been seen by the worker before it can be closed away
          // (the OWNER may close it unseen — a worker who has left or is switched off can never press "Theek hai", and his
          //  book must still be closable — Grok final review 09-10)
          && (o.status == 'cancelled' ? (o.get('cancelledBy', '') == o.by || o.get('rejectAck', false) == true || role == 'owner') : o.get('approval', 'pending') == 'ok')
          // an advance must already be in Attendance / the Welder app: once closed nobody can mark it entered any more
          && (o.status == 'cancelled' || o.kind != 'adv' || o.get('advStatus', '') == 'entered'))
        ||
        // cancel: staff any time; the spender their own line within 24 h
        (fxCancelOk(me, o, r)
          && (role in ['owner', 'incharge'] || (o.by == me && request.time < o.createdAt + duration.value(24, 'h')))
          // an advance Attendance already holds, or one waiting in the Welder inbox, is corrected THERE first — cancelling
          // it here would refund Falcon while the salary deduction stays (review 09-10-2026)
          && !fxAdvLocked(o)
          && fxLastOp(o.by) == 'x:' + id)
        // owner marks an advance as entered in Attendance (no money field changes; balance untouched)
        || (role == 'owner' && o.kind == 'adv' && o.status == 'active' && o.advStatus == 'pending'
          && r.diff(o).affectedKeys().hasOnly(['advStatus', 'advDoneBy', 'advDoneAt'])
          && r.advStatus == 'entered' && r.advDoneBy == me && r.advDoneAt == request.time)
        // Edit (owner 08-10-2026 19:31): the OWNER may change amount, date, name and type of any open line, with a reason;
        // Anshul ji may change the NAME only (+ reason). Person and photo never change. If the amount changes, the person's
        // balance moves by the difference in the same batch (lastOp 'a:' + id). Old and first values stay on the line.
        || (role in ['owner', 'incharge'] && o.status == 'active'
          && r.diff(o).affectedKeys().hasOnly(['detail', 'head', 'advFor', 'amount', 'date', 'editedBy', 'editedAt', 'editReason',
               'oldDetail', 'oldHead', 'oldAmount', 'oldDate', 'firstDetail', 'firstHead', 'firstAmount', 'firstDate'])
          && fxStr(r.detail, 120) && r.detail.size() > 0
          && r.editedBy == me && r.editedAt == request.time && r.editReason is string && r.editReason.size() > 0 && r.editReason.size() <= 100
          && r.oldDetail == o.detail && r.oldHead == o.get('head', '') && r.oldAmount == o.amount && r.oldDate == o.date
          // the very first values are kept for ever (write-once), however many edits follow
          && r.firstDetail == o.get('firstDetail', o.detail) && r.firstHead == o.get('firstHead', o.get('head', ''))
          && r.firstAmount == o.get('firstAmount', o.amount) && r.firstDate == o.get('firstDate', o.date)
          // Anshul ji: name only. Owner: amount (balance follows) and date (any past day, never future) too
          && (role == 'owner' || (r.amount == o.amount && r.date == o.date && r.get('head', '') == o.get('head', '')))
          && fxInt(r.amount, 200000) && fxIsDate(r.date) && fxDayStart(r.date) <= request.time + duration.value(5, 'm')
          // a changed amount: the person's spent must move by exactly the difference in THIS batch (lastOp alone could be a
          // stale 'a:' left by an earlier edit of the same line — Codex final review 09-10)
          && (r.amount == o.amount || (fxLastOp(o.by) == 'a:' + id
            && getAfter(fxP('balances', o.by)).data.get('spent', 0) - get(fxP('balances', o.by)).data.get('spent', 0) == r.amount - o.amount))
          // an advance already entered in Attendance keeps its name (Attendance was booked under it)
          && !fxAdvLocked(o)
          // an advance has no head; its name is the person, kept in step with advFor
          && (o.kind == 'adv'
            ? (r.get('head', '') == o.get('head', '') && r.advFor.name == r.detail && r.advFor.get('code', '') == o.advFor.get('code', ''))
            : (r.get('advFor', null) == o.get('advFor', null)
              && (r.head == 'Suspense' || fxHead(r.head)))))
      );
    }
    match /apps/falcon/entries/{id} {
      allow read: if fxEntryRead();
      allow create: if fxEntryCreate(id);
      allow update: if fxEntryUpdate(id);
      allow delete: if false;
    }

    // Photos are never listed (list = false); one is fetched when someone taps a line.
    function fxPhotoCreate(id) {
      let d = request.resource.data;
      let me = fxMe();
      return fxActive() && d.keys().hasOnly(['id', 'by', 'data', 'createdAt'])
        && d.id == id && d.by == me
        && d.data is string && d.data.size() < 250000
        && d.data[0:23] == 'data:image/jpeg;base64,'
        && !exists(fxP('entries', id)) && existsAfter(fxP('entries', id)) && getAfter(fxP('entries', id)).data.by == me;
    }
    match /apps/falcon/photos/{id} {
      allow get: if fxEntryRead();
      allow list: if false;
      allow create: if fxPhotoCreate(id);
      allow update, delete: if false;
    }

    function fxTransferRead() { let role = fxRoleOf(); return role != '' && (resource.data.to == fxMe() || resource.data.givenBy == fxMe() || role in ['owner', 'incharge']); }
    function fxTransferCreate(id) {
      let d = request.resource.data;
      let role = fxRoleOf();
      let me = fxMe();
      // 'hand' = one worker hands cash to another (owner 08-10-2026: Sandeep ⇄ Jitender). Only a spender creates it, and
      // BOTH balances move in the same batch: the giver's received goes down, the receiver's goes up.
      // Anshul ji's own float (owner 08-10-2026): the owner gives cash to Anshul ji too; Anshul ji's give / wapas to a worker
      // carries fromBal == true and moves HIS balance as well; 'in' = cash Anshul ji received (from the owner or elsewhere:
      // O-50, Sachin, scrap…), written by himself on himself, source in the note. Owner OR Anshul ji may record the owner's cash.
      let fromBal = d.get('fromBal', false);
      // src (owner 08-10-2026 18:09): Anshul ji sometimes hands a worker OFFICE cash, not his own float — then src == 'office'
      // and his balance stays put. Any other give / wapas by him comes out of his float (src 'float').
      let src = d.get('src', 'float');
      let pend = d.kind == 'return' && d.to == me;
      return d.keys().hasOnly(['id', 'to', 'toName', 'amount', 'kind', 'note', 'date', 'givenBy', 'givenByName', 'fromBal', 'src',
             'createdAt', 'clientAt', 'confirmedAt', 'confirmedBy', 'status', 'deviceId', 'schemaVersion', 'hisab', 'approval'])
        // owner 09-10-2026: cash coming BACK is written by the person who returns it, ON HIMSELF (to == givenBy), and is
        // born 'pending': it moves NO balance until it is approved — a worker's by the owner or Anshul ji, Anshul ji's by the
        // owner only (see fxTransferUpdate). Nothing else may carry the field.
        && (pend ? d.get('approval', '') == 'pending' : !d.keys().hasAny(['approval']))
        // office cash: only for a GIVE by Anshul ji. Cash he takes back from a worker always lands in his own float, so it can
        // reach the office / owner only through his own wapas — which needs the owner's OK (owner 09-10-2026).
        && src in ['float', 'office'] && (src == 'float' || (role == 'incharge' && d.kind == 'give'))
        && d.id == id && d.givenBy == me && d.to is string && d.get('hisab', null) == null
        && fxStr(d.toName, 40) && fxStr(d.givenByName, 40)
        && fxInt(d.amount, 200000) && fxDateOk(d.date)
        && d.status == 'active' && d.confirmedAt == null
        && d.createdAt == request.time && fxStr(d.note, 120)
        && (pend || fxLastOp(d.to) == 't:' + id)
        && (d.kind == 'in'
          ? (role == 'incharge' && d.to == me && fromBal == false && d.note.size() > 0)
          // a worker or Anshul ji returns cash: a pending wapas on himself, no balance write in this batch
          : pend ? (role in ['spender', 'incharge'] && fromBal == false && src == 'float')
          : (d.to != me && exists(fxP('users', d.to)) && fxTransferPair(d.kind, role, fxUserRole(fxP('users', d.to)), fromBal, src)
            // one opening per person, and only before their balance exists
            && (d.kind != 'opening' || !exists(fxP('balances', d.to)))
            && (fromBal == false || fxLastOp(me) == 't:' + id)
            // a worker cannot hand over more than he holds (same doc as fxLastOp(me), so no extra read)
            && (d.kind != 'hand' || fxInHandAfter(me) >= 0)));
    }
    function fxInHandAfter(email) { let b = getAfter(fxP('balances', email)).data; return b.get('received', 0) - b.get('spent', 0); }
    // who may move cash to whom (giver role → receiver role), and whether the giver's own balance moves (fromBal)
    function fxTransferPair(kind, role, toRole, fromBal, src) {
      return kind == 'hand' ? (role == 'spender' && toRole == 'spender' && fromBal == true)
        : (kind == 'opening' ? (role == 'owner' && toRole in ['spender', 'incharge'] && fromBal == false)
        // Nobody takes cash back by writing it himself any more — not Anshul ji, not the owner (Codex + Grok final review
        // 09-10): returned cash has ONE route, the returner's own pending wapas + an OK, which also checks what he holds.
        : (kind == 'give' && (
            (role == 'owner' && toRole in ['spender', 'incharge'] && fromBal == false)
            // Anshul ji: from his float (fromBal) — or office cash (src 'office', his balance untouched)
            // (a give only: cash coming back to him goes through the worker's own pending wapas + his "Mujhe mila" — one
            //  route, so the same cash can never be taken off the worker twice — Codex + reviewer 09-10)
            || (role == 'incharge' && kind == 'give' && toRole == 'spender' && fromBal == (src != 'office')))));
    }
    function fxTransferUpdate(id) {
      let role = fxRoleOf();
      let me = fxMe();
      let o = resource.data;
      let r = request.resource.data;
      return role != '' && (
        // the recipient confirms "Paisa mila" once; money fields never change — allowed even after a Hisab final
        (o.to == me && o.status == 'active' && o.confirmedAt == null && o.kind != 'return'
          && r.diff(o).affectedKeys().hasOnly(['confirmedAt', 'confirmedBy'])
          && r.confirmedAt == request.time && r.confirmedBy == me)
        // Hisab final closes the worker's transfers too (same batch as hisabs/{hid}); only confirmed or cancelled cash closes
        || (role in ['owner', 'incharge'] && o.get('hisab', null) == null && r.diff(o).affectedKeys().hasOnly(['hisab'])
          && r.hisab is string && fxHisabOf(r.hisab, o.to) && (o.status == 'cancelled' || o.confirmedAt != null || o.kind != 'hand')
          && (o.status == 'cancelled' || o.get('approval', null) != 'pending'))
        // OK of a returned amount = the moment the money moves (lastOp 'r:'): the returner's balance goes down by it; when
        // Anshul ji is the one who took it (recvBal) it is added to HIS float in the same batch. The owner may OK anyone's;
        // Anshul ji only a worker's, never his own. The returner must actually hold that much.
        || (o.status == 'active' && o.get('approval', null) == 'pending' && o.to != me
          && (role == 'owner' || (role == 'incharge' && fxUserRole(fxP('users', o.to)) == 'spender'))
          && r.diff(o).affectedKeys().hasOnly(['approval', 'approvedBy', 'approvedAt', 'recvBal'])
          && r.approval == 'ok' && r.approvedBy == me && r.approvedAt == request.time
          && r.get('recvBal', false) == (role == 'incharge')
          && fxLastOp(o.to) == 'r:' + id && fxInHandAfter(o.to) >= 0
          && (role == 'owner' || fxLastOp(me) == 'r:' + id))
        // a pending returned amount never moved money: the owner / Anshul ji (a worker's) reject it, or its writer withdraws it
        || (o.get('approval', null) == 'pending' && o.get('hisab', null) == null && fxCancelOk(me, o, r)
          && (role == 'owner' || o.givenBy == me || (role == 'incharge' && fxUserRole(fxP('users', o.to)) == 'spender')))
        // cancel: owner any time; the giver (Anshul ji, or the worker for his own hand-over) only while it is still unconfirmed;
        // never once the line sits in a final hisab
        // (a returned amount is cancelled above while pending; once OK'd it is final — correct it with a fresh Diya)
        // (gives are never confirmed since 09-10, so Anshul ji's window to undo his own give is 24 h; after that the owner does it)
        || (o.get('hisab', null) == null && !('approval' in o) && (role == 'owner' || (o.givenBy == me && o.confirmedAt == null
            && (o.kind == 'hand' || (role == 'incharge' && request.time < o.createdAt + duration.value(24, 'h')))))
          && fxCancelOk(me, o, r) && fxLastOp(o.to) == 'y:' + id
          && (o.get('fromBal', false) == false || fxLastOp(o.givenBy) == 'y:' + id))
      );
    }
    match /apps/falcon/transfers/{id} {
      allow read: if fxTransferRead();
      allow create: if fxTransferCreate(id);
      allow update: if fxTransferUpdate(id);
      allow delete: if false;
    }

    // balances/{email} = { email, received, spent, lastOp, updatedAt }. A write is valid only together with the
    // record named in lastOp, created or cancelled in the SAME batch, and the delta must equal its amount exactly.
    function fxBefore(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    function fxDR() { return request.resource.data.get('received', 0) - fxBefore('received'); }
    function fxDS() { return request.resource.data.get('spent', 0) - fxBefore('spent'); }
    function fxSign(kind) { return kind == 'return' ? -1 : 1; }
    function fxBalE(email, rid) { let e = getAfter(fxP('entries', rid)).data; return !exists(fxP('entries', rid)) && e.by == email && fxDS() == e.amount && fxDR() == 0; }
    function fxBalX(email, rid) { let e = get(fxP('entries', rid)).data; return e.status == 'active' && getAfter(fxP('entries', rid)).data.status == 'cancelled' && e.by == email && fxDS() == -e.amount && fxDR() == 0; }
    function fxBalT(email, rid) { let t = getAfter(fxP('transfers', rid)).data; return !exists(fxP('transfers', rid)) && !('approval' in t) && fxDS() == 0 && ((t.to == email && fxDR() == fxSign(t.kind) * t.amount) || (t.get('fromBal', false) == true && t.givenBy == email && fxDR() == -fxSign(t.kind) * t.amount)); }
    // owner's amount edit: spent moves by exactly (new − old) of that person's active line, in the same batch
    function fxBalA(email, rid) { let o = get(fxP('entries', rid)).data; let n = getAfter(fxP('entries', rid)).data; return o.status == 'active' && n.status == 'active' && o.by == email && n.by == email && fxDS() == n.amount - o.amount && fxDR() == 0; }
    // 'r:' = a returned amount is OK'd: the returner's received goes down; Anshul ji's goes up when he is the one who took it
    function fxBalR(email, rid) {
      let o = get(fxP('transfers', rid)).data;
      let n = getAfter(fxP('transfers', rid)).data;
      return o.status == 'active' && o.get('approval', '') == 'pending' && n.get('approval', '') == 'ok' && fxDS() == 0
        && ((o.to == email && fxDR() == -o.amount)
          || (o.to != email && n.get('recvBal', false) == true && n.approvedBy == email && fxDR() == o.amount));
    }
    function fxBalY(email, rid) { let t = get(fxP('transfers', rid)).data; return !('approval' in t) && t.status == 'active' && getAfter(fxP('transfers', rid)).data.status == 'cancelled' && fxDS() == 0 && ((t.to == email && fxDR() == -fxSign(t.kind) * t.amount) || (t.get('fromBal', false) == true && t.givenBy == email && fxDR() == fxSign(t.kind) * t.amount)); }
    function fxBalOk(email) {
      let d = request.resource.data;
      let op = d.lastOp;
      let tag = op[0:2];
      let rid = op[2:op.size()];
      return fxActive() && d.keys().hasOnly(['email', 'received', 'spent', 'lastOp', 'updatedAt'])
        && d.email == email && op is string && op.size() > 2 && op.size() < 80 && d.updatedAt == request.time
        && (tag == 'e:' ? fxBalE(email, rid) : (tag == 'x:' ? fxBalX(email, rid) : (tag == 't:' ? fxBalT(email, rid) : (tag == 'y:' ? fxBalY(email, rid) : (tag == 'a:' ? fxBalA(email, rid) : (tag == 'r:' ? fxBalR(email, rid) : false))))));
    }
    // Hisab final (owner 08-10-2026): staff close a worker's book. hisabs/{hid} = { id, email, name, closedAt, closedBy, prev,
    // received, spent, closing, lines } with received/spent copied from the worker's balance doc AT THIS MOMENT (checked here),
    // so the carry-forward can never drift from the money. The balance doc itself is not reset — closing IS the carry.
    function fxHisabOf(hid, email) { let h = getAfter(fxP('hisabs', hid)).data; return !exists(fxP('hisabs', hid)) && h.email == email; }
    function fxHisabCreate(id) {
      let d = request.resource.data;
      let b = get(fxP('balances', d.email)).data;
      return fxRoleOf() in ['owner', 'incharge']
        && d.keys().hasOnly(['id', 'email', 'name', 'closedAt', 'closedBy', 'prev', 'received', 'spent', 'closing', 'lines', 'note', 'schemaVersion'])
        && d.id == id && d.email is string && exists(fxP('users', d.email)) && fxUserRole(fxP('users', d.email)) != 'owner'
        && d.closedAt == request.time && d.closedBy == fxMe() && fxStr(d.name, 40) && fxStr(d.note, 120)
        && d.received == b.get('received', 0) && d.spent == b.get('spent', 0) && d.closing == d.received - d.spent
        && d.lines is int && d.lines >= 0 && (d.prev == null || d.prev is string);
    }
    match /apps/falcon/hisabs/{id} {
      allow read: if fxUsersRead(resource.data.email);
      allow create: if fxHisabCreate(id);
      allow update, delete: if false;
    }
    // Worker name list for the Advance tile (owner 08-10-2026): mirrored from att_salary by attendance-app/jobs/falconRoster.js
    // (admin SDK). Phones only read it; name + dept + code, no pay data.
    match /apps/falcon/roster/{code} {
      allow read: if fxActive();
      allow write: if false;
    }
    match /apps/falcon/balances/{email} {
      allow read: if fxUsersRead(email);
      allow create, update: if fxBalOk(email);
      allow delete: if false;
    }
    // <<< FALCON BLOCK
    // >>> MACHINES BLOCK (managed by machine-list/rules/compose.mjs — do not edit by hand)
    // ---- Machine List (apps/machines) — 07-Oct-2026, tightened 08-Oct-2026 after the Codex / ChatGPT / Grok reviews ----
    // Roles from apps/machines/users/{email}: active == true AND role in owner | editor | viewer. Anything else = no access.
    // Nothing is ever deleted: a removed machine is saved with active == false, a blocked person with active == false.
    function mcPath() { return /databases/$(database)/documents/apps/machines/users/$(tEmail()); }
    function mcRole() {
      return !signedIn() || tEmail() == '' ? '' : (bootstrapOwner() ? 'owner'
        : (exists(mcPath()) && get(mcPath()).data.get('active', false) == true
           && get(mcPath()).data.get('role', '') in ['owner', 'editor', 'viewer'] ? get(mcPath()).data.role : ''));
    }
    function mcItemPath(id) { return /databases/$(database)/documents/apps/machines/items/$(id); }
    function mcPhotoPath(id) { return /databases/$(database)/documents/apps/machines/photos/$(id); }
    function mcStr(d, k, max) { return d[k] is string && d[k].size() <= max; }
    function mcItemOk(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','no','department','name','capacity','make','usedFor','counterFitted','counterWorking','status',
                               'operator','remark','thumb','hasPhoto','photoCount','active','rev','lastSaveId','createdBy','createdAt','updatedBy','updatedAt'])
        && d.id == id
        // machine ids are plain (letters, digits, _ and -) and never contain "__", which is the photo-slot separator
        && id.matches('^[A-Za-z0-9_-]{1,60}$') && id.split('__').size() == 1
        && mcStr(d, 'no', 20) && d.no.size() > 0
        && mcStr(d, 'department', 60) && d.department.size() > 0
        && mcStr(d, 'name', 120) && mcStr(d, 'capacity', 60) && mcStr(d, 'make', 80) && mcStr(d, 'usedFor', 200)
        && d.counterFitted in ['', 'yes', 'no'] && d.counterWorking in ['', 'yes', 'no']
        && d.status in ['running', 'repair', 'stopped']
        && mcStr(d, 'operator', 80) && mcStr(d, 'remark', 300)
        && mcStr(d, 'thumb', 60000)
        && d.hasPhoto is bool && d.active is bool && d.rev is int
        // up to 5 photos; hasPhoto simply says whether there is at least one
        // (a save from the previous app version carries no photoCount: it has 0 or 1 photo, as hasPhoto says)
        && (!('photoCount' in d) || (d.photoCount is int && d.photoCount >= 0 && d.photoCount <= 5 && d.hasPhoto == (d.photoCount > 0)))
        // every save carries its own token: the app's proof, later, that THIS save is the one stored
        && mcStr(d, 'lastSaveId', 80) && d.lastSaveId.size() > 0
        // a machine that says it has a photo must have that photo once this save (one batch) is applied
        && (d.hasPhoto == false || existsAfter(mcPhotoPath(id)))
        && d.updatedBy == tEmail() && d.updatedAt == request.time;
    }
    match /apps/machines/items/{id} {
      allow read: if mcRole() != '';
      allow delete: if false;
      // new machine: version 1, creation fields stamped now
      allow create: if mcRole() in ['owner', 'editor'] && mcItemOk(id)
        && request.resource.data.rev == 1
        && request.resource.data.createdBy == tEmail() && request.resource.data.createdAt == request.time;
      // change: exactly the next version (a stale form or a second phone is refused); creation fields never move
      allow update: if mcRole() in ['owner', 'editor'] && mcItemOk(id)
        && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // photos/{machineId} = main photo (slot 1); photos/{machineId}__2 … __5 = more photos of the same machine.
    // The id is parsed ONE way only: a machine id never contains "__", so a photo id is either exactly a machine id,
    // or exactly "<machine id>__<2..5>" — nothing else (no "m__2__5", no machine called "m__2").
    function mcPhotoParts(pid) { return pid.split('__'); }
    function mcPhotoMachine(pid) { return mcPhotoParts(pid)[0]; }
    function mcPhotoSlotOk(pid) {
      return mcPhotoParts(pid).size() == 1
        || (mcPhotoParts(pid).size() == 2 && mcPhotoParts(pid)[1] in ['2', '3', '4', '5']
            && int(mcPhotoParts(pid)[1]) <= getAfter(mcItemPath(mcPhotoMachine(pid))).data.get('photoCount', 1));
    }
    match /apps/machines/photos/{id} {
      allow read: if mcRole() != '';
      allow delete: if false;
      // a photo only ever belongs to a machine that exists once this save is applied…
      allow create, update: if mcRole() in ['owner', 'editor']
        && request.resource.data.keys().hasOnly(['id', 'data', 'updatedBy', 'updatedAt'])
        && request.resource.data.id == id
        && request.resource.data.data is string && request.resource.data.data.size() <= 700000
        && request.resource.data.data.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.updatedBy == tEmail() && request.resource.data.updatedAt == request.time
        // …and only ever travels WITH a save of that machine (same batch): no photo-only change slips past the version rule
        && existsAfter(mcItemPath(mcPhotoMachine(id)))
        && getAfter(mcItemPath(mcPhotoMachine(id))).data.hasPhoto == true
        && getAfter(mcItemPath(mcPhotoMachine(id))).data.updatedAt == request.time
        && mcPhotoSlotOk(id);
    }
    match /apps/machines/meta/{id} {
      allow read: if mcRole() != '';
      allow delete: if false;
      allow create, update: if mcRole() == 'owner';
    }
    // users: a signed-in Google account may read ITS OWN doc (to resolve its role); only the owner lists/writes.
    // A person is blocked with active == false, never deleted.
    match /apps/machines/users/{id} {
      allow get: if nonAnon() && (id == tEmail() || mcRole() == 'owner');
      allow list: if mcRole() == 'owner';
      allow delete: if false;
      allow create, update: if mcRole() == 'owner'
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'active'])
        && request.resource.data.email == id
        && request.resource.data.role in ['owner', 'editor', 'viewer']
        && request.resource.data.active is bool
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 80;
    }
    // <<< MACHINES BLOCK
    // Read-meter telemetry (usage_reads/{YYYY-MM-DD}): every app instance batches
    // increments into totals.<app>. Write-only for any signed-in user (incl. anon
    // workers) so ALL apps can report; shape-locked to counters, no client reads.
    match /usage_reads/{day} {
      allow read, delete: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['totals', 'updatedAt']);
    }

    // 2026-09-22: Oracle WhatsApp sender (send-only VM) — scoped email/password login, NO service key
    // on that box. May list/claim/mark alert-queue docs and enqueue new ones; nothing else is visible.
    function isWaSender() { return request.auth != null && request.auth.uid == 'h9CtDCooxzSr3C0CCxjo3cPF0w63'; }
    match /wa_outbox/{id} {
      allow read: if isWaSender();
      allow create: if isWaSender() && request.resource.data.status == 'pending' && request.resource.data.text is string;
      allow update: if isWaSender() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'claimedAt', 'claimedBy', 'sentAt', 'sentBy', 'error', 'erroredAt', 'expiredAt', 'skipOracle']);
    }

    // Lock everything else.
    match /{document=**} { allow read, write: if false; }
  }
}